{
  "manifest_version": 3,
  "name": "YouTune - Personal Listening Tuner",
  "version": "0.2.1",
  "description": "A privacy-first 10-band audio equalizer with 16 local listening presets for YouTube and YouTube Music.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YouTune",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
